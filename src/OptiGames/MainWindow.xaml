<Window x:Class="OptiGames.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:OptiGames.ViewModels"
        xmlns:views="clr-namespace:OptiGames.Views"
        Title="OptiGames" Height="760" Width="1240"
        MinHeight="620" MinWidth="1020"
        Icon="/Assets/optigames.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource B.Border}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== Sidebar ==================== -->
            <Border Grid.Column="0" Background="{StaticResource B.Sidebar}">
                <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,0,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Wordmark -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="4,0,0,0">
                            <Image Source="/Assets/logo.png" Width="20" Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="OPTIGAMES" FontSize="14.5" FontWeight="Bold"
                                       Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource B.Border}"
                                   Margin="4,8,4,12"/>

                        <!-- Primary destinations -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding MainPages}"
                                      ItemTemplate="{StaticResource S.NavRow}"
                                      VerticalAlignment="Top"/>

                        <!-- Help / Settings -->
                        <StackPanel Grid.Row="3">
                            <Rectangle Height="1" Fill="{StaticResource B.Border}" Margin="4,0,4,12"/>
                            <ItemsControl ItemsSource="{Binding FooterPages}"
                                          ItemTemplate="{StaticResource S.NavRow}"/>
                            <TextBlock Text="{Binding Settings.Version, StringFormat=v{0}}"
                                       Style="{StaticResource T.Label}"
                                       Margin="12,14,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ==================== Content ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0">
                    <TextBlock Text="{Binding Current.Title}" Style="{StaticResource T.PageTitle}"
                               VerticalAlignment="Center" Margin="28,0,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,10,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource S.CaptionButton}" Click="Minimize_Click"
                                ToolTip="Minimise">
                            <Path Data="{StaticResource I.Minimize}" Stroke="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource S.CaptionButtonClose}" Click="Close_Click"
                                ToolTip="Close">
                            <Path Data="{StaticResource I.Close}" Stroke="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Page host. The fade+lift makes navigation feel like a transition
                     rather than a repaint. -->
                <ContentControl Grid.Row="1" Content="{Binding Current}" Margin="0"
                                x:Name="PageHost">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift"/>
                    </ContentControl.RenderTransform>
                </ContentControl>

                <!-- Action log -->
                <Expander Grid.Row="2" IsExpanded="False" Style="{StaticResource S.LogExpander}"
                          Header="Action log">
                    <Border Background="#FF0B0B0D" BorderBrush="{StaticResource B.Border}"
                            BorderThickness="0,1,0,0" Height="150">
                        <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto"
                                      Padding="24,10">
                            <TextBlock Text="{Binding LogText}" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11.5" Foreground="{StaticResource B.TextDim}"
                                       TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>

            <!-- ==================== Modal ==================== -->
            <Grid Grid.ColumnSpan="2" Background="#CC000000"
                  Visibility="{Binding IsModalOpen, Converter={StaticResource Vis}}"
                  Panel.ZIndex="50">
                <Border Style="{StaticResource S.Card}" Width="440" MaxHeight="440"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        DataContext="{Binding Modal}">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/>
                    </Border.Effect>
                    <StackPanel Margin="26">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.PageTitle}"
                                   FontSize="17" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Body}" Style="{StaticResource T.Body}"
                                   Margin="0,12,0,22"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding CancelText}"
                                    Style="{StaticResource S.ButtonGhost}"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CancelCommand}"
                                    Visibility="{Binding ShowCancel, Converter={StaticResource Vis}}"/>
                            <Button Grid.Column="1" Content="{Binding ConfirmText}"
                                    Style="{StaticResource S.ButtonPrimary}"
                                    Command="{Binding ConfirmCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== Bug report ====================
                 Above the modal so a confirmation dialog raised while it is open still
                 lands on top, below onboarding so a first run is never interrupted. -->
            <views:BugReportView Grid.ColumnSpan="2" Panel.ZIndex="60"
                                 DataContext="{Binding BugReport}"
                                 Visibility="{Binding DataContext.IsBugReportOpen,
                                              RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource Vis}}"/>

            <!-- ==================== Onboarding ==================== -->
            <views:OnboardingView Grid.ColumnSpan="2" Panel.ZIndex="100"
                                  DataContext="{Binding Onboarding}"
                                  Visibility="{Binding DataContext.IsOnboarding,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource Vis}}"/>
        </Grid>
    </Border>
</Window>
