<UserControl x:Class="OptiGames.Views.BugReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="S.Field" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource B.Input}"
                                BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource B.AccentEdge}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#D9000000">
        <Border Style="{StaticResource S.Card}" Width="560" MaxHeight="700"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="46" ShadowDepth="0" Opacity="0.75"/>
            </Border.Effect>

            <Grid Margin="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource S.Icon}" Data="{StaticResource I.Bug}"
                              Width="20" Height="20" Stroke="{StaticResource B.Accent}"
                              Margin="0,0,12,0"/>
                        <TextBlock Text="Report a bug" Style="{StaticResource T.PageTitle}"
                                   FontSize="17" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource S.CaptionButton}" Width="30" Height="30"
                            HorizontalAlignment="Right" Command="{Binding CloseCommand}"
                            ToolTip="Close">
                        <Path Data="{StaticResource I.Close}" Width="13" Height="13"
                              Stretch="Uniform" StrokeThickness="1.6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>

                <!-- ===== Form ===== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsSent, Converter={StaticResource VisInv}}">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="YOUR EMAIL" Style="{StaticResource T.Label}"/>
                        <TextBox Style="{StaticResource S.Field}" Margin="0,7,0,0"
                                 IsEnabled="{Binding IsEditable}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource T.Body}" FontSize="11.5" Margin="0,6,0,0"
                                   Text="We reply here. Without it there is no way to tell you it is fixed."/>

                        <TextBlock Text="WHAT HAPPENED" Style="{StaticResource T.Label}" Margin="0,18,0,0"/>
                        <TextBox Style="{StaticResource S.Field}" Margin="0,7,0,0"
                                 Height="120" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 IsEnabled="{Binding IsEditable}"
                                 Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource T.Body}" FontSize="11.5" Margin="0,6,0,0"
                                   Text="What you did, what you expected, and what happened instead."/>

                        <!-- Attachments -->
                        <Grid Margin="0,18,0,0">
                            <TextBlock Text="SCREENSHOTS" Style="{StaticResource T.Label}"/>
                            <Button Content="Attach images" Style="{StaticResource S.ButtonGhost}"
                                    Padding="10,4" FontSize="11.5" HorizontalAlignment="Right"
                                    Margin="0,-6,0,0"
                                    IsEnabled="{Binding IsEditable}"
                                    Command="{Binding AttachCommand}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource B.Input}"
                                            BorderBrush="{StaticResource B.Border}"
                                            BorderThickness="1" CornerRadius="7"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                       FontSize="11.5" Margin="12,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource B.TextMuted}"/>
                                            <Button Grid.Column="2" Style="{StaticResource S.ButtonGhost}"
                                                    Padding="6,2" Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove">
                                                <Path Data="{StaticResource I.Close}" Width="10" Height="10"
                                                      Stretch="Uniform" StrokeThickness="1.8"
                                                      Stroke="{StaticResource B.TextMuted}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource T.Body}" FontSize="11.5"
                                   Visibility="{Binding HasAttachments, Converter={StaticResource VisInv}}"
                                   Text="PNG, JPG, WEBP or GIF, up to 8MB each."/>

                        <!-- Diagnostics -->
                        <Border Background="{StaticResource B.Input}" CornerRadius="8"
                                BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                Padding="14,12" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Include system details"
                                                   Style="{StaticResource T.CardTitle}" FontSize="13"/>
                                        <TextBlock Style="{StaticResource T.Body}" FontSize="11.5"
                                                   Margin="0,4,0,0"
                                                   Text="Your hardware, Windows build, which tweaks are applied, and the last 40 lines of the action log."/>
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource S.Toggle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                                  IsEnabled="{Binding IsEditable}"
                                                  IsChecked="{Binding IncludeDiagnostics, Mode=TwoWay}"/>
                                </Grid>

                                <ToggleButton Content="Show me exactly what is sent"
                                              IsChecked="{Binding ShowDiagnostics, Mode=TwoWay}"
                                              Margin="0,10,0,0" HorizontalAlignment="Left"
                                              Cursor="Hand" Focusable="False"
                                              Visibility="{Binding IncludeDiagnostics, Converter={StaticResource Vis}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                                       Foreground="{StaticResource B.Accent}"
                                                       TextDecorations="Underline"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Border Background="#FF0B0B0D" CornerRadius="6" Margin="0,10,0,0"
                                        BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                        Visibility="{Binding ShowDiagnostics, Converter={StaticResource Vis}}">
                                    <ScrollViewer MaxHeight="150" Padding="10,8"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding DiagnosticsText}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource B.TextDim}"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="#1AFF2A2A" CornerRadius="7" Padding="12,9" Margin="0,14,0,0"
                                BorderBrush="{StaticResource B.AccentEdge}" BorderThickness="1"
                                Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Error}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource B.Accent}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Sent ===== -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center"
                            Visibility="{Binding IsSent, Converter={StaticResource Vis}}">
                    <Path Data="{StaticResource I.Check}" Width="40" Height="40" Stretch="Uniform"
                          Stroke="{StaticResource B.Good}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" HorizontalAlignment="Center"/>
                    <TextBlock Text="Report sent" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource T.Body}" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="380"
                               Text="It is in our support inbox and only the team can see it. We will reply to the email you gave."/>
                </StackPanel>

                <!-- ===== Footer ===== -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource T.Body}"
                               FontSize="11.5" VerticalAlignment="Center"
                               Visibility="{Binding Status, Converter={StaticResource VisStr}}"/>

                    <!-- Why Send is greyed out. Shares the row with Status, which is only ever
                         set while sending — by which point the hint is empty. -->
                    <TextBlock Text="{Binding SubmitHint}" Style="{StaticResource T.Body}"
                               FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="290" HorizontalAlignment="Left"
                               Foreground="{StaticResource B.TextMuted}"
                               Visibility="{Binding HasSubmitHint, Converter={StaticResource Vis}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding IsSent, Converter={StaticResource VisInv}}">
                        <Button Content="Cancel" Style="{StaticResource S.ButtonGhost}"
                                Command="{Binding CloseCommand}" Margin="0,0,8,0"/>
                        <Button Content="Send report" Style="{StaticResource S.ButtonPrimary}"
                                Command="{Binding SubmitCommand}" MinWidth="140"/>
                    </StackPanel>

                    <Button Content="Done" Style="{StaticResource S.ButtonPrimary}"
                            HorizontalAlignment="Right" MinWidth="120"
                            Command="{Binding DoneCommand}"
                            Visibility="{Binding IsSent, Converter={StaticResource Vis}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
