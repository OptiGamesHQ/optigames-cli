<UserControl x:Class="OptiGames.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">

        <!-- The lift transform is declared inline rather than in a style: a RenderTransform
             inside a Setter is shared by every element using that style. -->
        <Grid>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PageLift" Y="16"/>
            </Grid.RenderTransform>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PageLift"
                                             Storyboard.TargetProperty="Y"
                                             To="0" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================ Banner ============================
                 Full bleed, so the 16:9 brand render keeps its whole composition
                 instead of being cropped to a portrait card. -->
            <Border Grid.Row="0" Height="200" ClipToBounds="True"
                    BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- The source is 3840x2160. Decoding it in full would cost roughly 33 MB
                         of bitmap for a strip that is never wider than about 1000px, so it is
                         decoded down on load. -->
                    <Image Stretch="UniformToFill" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <BitmapImage UriSource="/Assets/brand-banner.png" DecodePixelWidth="1600"/>
                        </Image.Source>
                    </Image>

                    <!-- Left weighted scrim, so the heading sits on darkness and the art is
                         left readable on the right hand side. -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F20A0A0C" Offset="0"/>
                                <GradientStop Color="#D90A0A0C" Offset="0.3"/>
                                <GradientStop Color="#800A0A0C" Offset="0.62"/>
                                <GradientStop Color="#000A0A0C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                                MaxWidth="520" Margin="28,0,0,0">
                        <TextBlock Text="OPTIGAMES" Style="{StaticResource T.Label}"
                                   Foreground="{StaticResource B.Accent}"/>
                        <TextBlock Text="Your system, tuned." FontSize="28" FontWeight="SemiBold"
                                   Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0" FontSize="13"
                                   Text="Every tweak is staged, reversible and explained. Take a look at your hardware below, then pick where to start."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Content ============================ -->
            <Grid Grid.Row="1" Margin="28,22,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Left: hardware ===== -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="My System" Style="{StaticResource T.CardTitle}"
                               FontSize="15" Margin="0,2,0,10"/>

                    <ItemsControl ItemsSource="{Binding Specs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource S.Card}" Margin="0,0,0,8" Padding="16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Path Grid.Column="0" Style="{StaticResource S.Icon}"
                                              Width="18" Height="18"
                                              Stroke="{StaticResource B.Accent}"
                                              Data="{Binding Icon, Converter={StaticResource Icon}}"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Width="98"
                                                   Margin="14,0,0,0" FontSize="12.5"
                                                   Foreground="{StaticResource B.TextDim}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5"
                                                   Foreground="{StaticResource B.Text}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Value}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== Right: live meters, status, actions ===== -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Right now" Style="{StaticResource T.CardTitle}"
                               FontSize="15" Margin="0,2,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU meter. The render sits behind the readout at low opacity with a
                             left-to-right scrim over it, so the card carries the hardware
                             without the numbers having to compete with it. Decoded down to
                             480px — these sources are ~1.8 MB at full size. -->
                        <Border Grid.Column="0" Style="{StaticResource S.Card}" ClipToBounds="True">
                            <Grid>
                                <Image Stretch="UniformToFill" Opacity="0.34"
                                       HorizontalAlignment="Right" Margin="0,0,-30,0"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source>
                                        <BitmapImage UriSource="/Assets/hero-cpu.png" DecodePixelWidth="480"/>
                                    </Image.Source>
                                </Image>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F2121215" Offset="0"/>
                                            <GradientStop Color="#B3121215" Offset="0.65"/>
                                            <GradientStop Color="#59121215" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            <StackPanel Margin="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource S.Icon}" Width="15" Height="15"
                                          Stroke="{StaticResource B.Accent}"
                                          Data="{StaticResource I.Chip}"/>
                                    <TextBlock Text="CPU" Style="{StaticResource T.Label}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding CpuText}" FontSize="30" FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="Last 60 seconds" Style="{StaticResource T.Label}"
                                           FontWeight="Normal" Margin="0,1,0,9"/>

                                <!-- Stretch="Fill" maps the view model's 0..1 by 0..38 geometry
                                     onto whatever width the card ends up with. It scales the
                                     geometry only, so the stroke stays 1.5px however wide the
                                     window is. -->
                                <!-- Stretch="None": the view model builds the points in real pixels using
                                     the width reported below, so the vertical axis stays a true
                                     0-100% instead of auto-fitting the visible range. -->
                                <Border Height="38" CornerRadius="3" ClipToBounds="True"
                                        SizeChanged="Spark_SizeChanged"
                                        Background="{StaticResource B.TickScaleDim}">
                                    <Polyline Points="{Binding CpuPoints}" Stretch="None"
                                              Stroke="{StaticResource B.Accent}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                </Border>
                            </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Memory meter -->
                        <Border Grid.Column="2" Style="{StaticResource S.Card}" ClipToBounds="True">
                            <Grid>
                                <Image Stretch="UniformToFill" Opacity="0.34"
                                       HorizontalAlignment="Right" Margin="0,0,-30,0"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source>
                                        <BitmapImage UriSource="/Assets/hero-ram.png" DecodePixelWidth="480"/>
                                    </Image.Source>
                                </Image>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F2121215" Offset="0"/>
                                            <GradientStop Color="#B3121215" Offset="0.65"/>
                                            <GradientStop Color="#59121215" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            <StackPanel Margin="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource S.Icon}" Width="15" Height="15"
                                          Stroke="{StaticResource B.Accent}"
                                          Data="{StaticResource I.Ram}"/>
                                    <TextBlock Text="Memory" Style="{StaticResource T.Label}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding RamPercent, StringFormat={}{0:0}%}"
                                           FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RamText}" Style="{StaticResource T.Label}"
                                           FontWeight="Normal" Margin="0,1,0,9"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Stretch="None": the view model builds the points in real pixels using
                                     the width reported below, so the vertical axis stays a true
                                     0-100% instead of auto-fitting the visible range. -->
                                <Border Height="38" CornerRadius="3" ClipToBounds="True"
                                        SizeChanged="Spark_SizeChanged"
                                        Background="{StaticResource B.TickScaleDim}">
                                    <Polyline Points="{Binding RamPoints}" Stretch="None"
                                              Stroke="{StaticResource B.Accent}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                </Border>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Status summary -->
                    <Border Style="{StaticResource S.Card}" Margin="0,12,0,0" Padding="18,15">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Tweaks" Style="{StaticResource T.CardTitle}"/>
                                <TextBlock Text="{Binding TweakSummary}" HorizontalAlignment="Right"
                                           FontSize="12.5"
                                           Foreground="{Binding HasTweaksApplied,
                                                        Converter={StaticResource StatusBrush}}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource B.Border}" Margin="0,13"/>
                            <Grid>
                                <TextBlock Text="Last cleanup" Style="{StaticResource T.CardTitle}"/>
                                <TextBlock Text="{Binding CleanSummary}" HorizontalAlignment="Right"
                                           FontSize="12.5" Foreground="{StaticResource B.TextDim}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource B.Border}" Margin="0,13"/>
                            <Grid>
                                <TextBlock Text="Restore point" Style="{StaticResource T.CardTitle}"/>
                                <TextBlock Text="{Binding RestoreSummary}" HorizontalAlignment="Right"
                                           FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{Binding HasRestorePoint,
                                                        Converter={StaticResource StatusBrush}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Where to start" Style="{StaticResource T.CardTitle}"
                               FontSize="15" Margin="2,18,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource S.HoverCard}" Padding="18,16">
                            <StackPanel>
                                <Path Style="{StaticResource S.Icon}" Width="20" Height="20"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Stroke="{StaticResource B.Accent}"
                                      Data="{StaticResource I.Bolt}"/>
                                <TextBlock Text="Optimize" Style="{StaticResource T.CardTitle}" Margin="0,12,0,4"/>
                                <TextBlock Text="Stage the tweaks you want, then apply them in one pass."
                                           Style="{StaticResource T.Body}"/>
                                <Button Content="Open Optimize" Style="{StaticResource S.Button}"
                                        Command="{Binding GoOptimize}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource S.HoverCard}" Padding="18,16">
                            <StackPanel>
                                <Path Style="{StaticResource S.Icon}" Width="20" Height="20"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Stroke="{StaticResource B.Accent}"
                                      Data="{StaticResource I.Disk}"/>
                                <TextBlock Text="Clean Drive" Style="{StaticResource T.CardTitle}" Margin="0,12,0,4"/>
                                <TextBlock Text="Reclaim the caches Windows never clears on its own."
                                           Style="{StaticResource T.Body}"/>
                                <Button Content="Open Clean Drive" Style="{StaticResource S.Button}"
                                        Command="{Binding GoClean}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
