<UserControl x:Class="OptiGames.Views.RestorePointView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page entrance: fade up over 260ms. -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.26">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="16" To="0" Duration="0:0:0.26">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="PageRoot" Margin="28,0,20,20" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="16"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Style="{StaticResource S.Card}" Padding="24,20" Margin="0,0,8,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Seated in the same rail and brackets as the other pages' hero art. The
                     render carries its own circuit traces running left and right, so it is
                     cropped to the shield itself and lets the frame's rail do that job
                     instead of doubling up on it. -->
                <ContentControl Grid.Column="0" Width="224" Height="112" Margin="0,0,18,0"
                                VerticalAlignment="Center" Style="{StaticResource S.HeroFrame}">
                    <!-- Feathered so the render's rectangle edge does not show against the
                         card; its backdrop is a dark vignette rather than the card colour. -->
                    <Image Source="/Assets/hero-shield.png" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.OpacityMask>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                                 RadiusX="0.58" RadiusY="0.66">
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="0.55"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Image.OpacityMask>
                    </Image>
                </ContentControl>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Your safety net" Style="{StaticResource T.CardTitle}" FontSize="15"/>
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,7,20,0" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="A restore point is a snapshot of your system settings and drivers. If a change ever causes trouble, roll back here and Windows undoes it in one step — your documents and games are left alone."/>
                    <TextBlock Text="{Binding Status}" FontSize="11.5" Margin="0,10,0,0"
                               Foreground="{StaticResource B.TextMuted}"
                               Visibility="{Binding Status, Converter={StaticResource VisStr}}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource S.ButtonPrimary}"
                        VerticalAlignment="Center" Command="{Binding CreateCommand}" MinWidth="190">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource S.Icon}" Data="{StaticResource I.Plus}"
                              Width="15" Height="15" Stroke="White" StrokeThickness="1.8"
                              Margin="0,0,9,0"/>
                        <TextBlock Text="Create restore point" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Table head =====
             Left and right edges match the card body inside the rows below: 1px border plus
             18px padding on the left, the same on the right plus the scrollbar gutter. -->
        <Grid Grid.Row="1" Margin="19,0,27,8"
              Visibility="{Binding IsEmpty, Converter={StaticResource VisInv}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="CREATED AT" Style="{StaticResource T.Label}"/>
            <TextBlock Grid.Column="1" Text="DESCRIPTION" Style="{StaticResource T.Label}"/>
        </Grid>

        <!-- ===== Points ===== -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource S.HoverCard}" Margin="0,0,0,8" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding CreatedAt}" FontSize="12.5"
                                               Foreground="{StaticResource B.Accent}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12.5"
                                               Foreground="{StaticResource B.Text}" Margin="0,0,16,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Restore" Style="{StaticResource S.Button}"
                                                Padding="18,8" Command="{Binding RestoreCommand}"/>
                                        <Button Style="{StaticResource S.ButtonDanger}" Margin="8,0,0,0"
                                                Command="{Binding DeleteCommand}" ToolTip="Delete">
                                            <Path Style="{StaticResource S.IconAccent}"
                                                  Data="{StaticResource I.Trash}"
                                                  Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60"
                        Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                <Path Style="{StaticResource S.Icon}" Data="{StaticResource I.Shield}"
                      Width="46" Height="46" Stroke="{StaticResource B.TextMuted}"
                      StrokeThickness="1.2" HorizontalAlignment="Center" Opacity="0.6"/>
                <TextBlock Text="No restore points yet" Style="{StaticResource T.CardTitle}"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="Create one before you change anything."
                           Style="{StaticResource T.Body}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
